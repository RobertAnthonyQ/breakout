# ───────── Web app (web/) ─────────
# dependencies
web/node_modules/
web/.pnp
web/.pnp.*
web/.yarn/*
!web/.yarn/patches
!web/.yarn/plugins
!web/.yarn/releases
!web/.yarn/versions

# next.js / build output
web/.next/
web/out/
web/build/
web/coverage/

# vercel
web/.vercel

# typescript
web/*.tsbuildinfo
web/next-env.d.ts

# keep VS Code MCP config tracked
!web/.vscode/mcp.json

# ───────── LaTeX build artifacts ─────────
*.aux
*.log
*.nav
*.snm
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.bcf
*.run.xml

# ───────── OS / editor ─────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
*.pem

# ───────── Env / secrets ─────────
.env
.env*

# ───────── Logs ─────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ───────── Temp ─────────
tmp/

# ───────── Python (if scripts added) ─────────
__pycache__/
*.pyc
.venv/

# ───────── Keep Claude context tracked ─────────
!.claude/
!.claude/**
