# Breakout Opportunities Hub — server-side configuration (copy to .env.local; set the same in Vercel)
# None of these are NEXT_PUBLIC_: they stay on the server and never reach the browser.

# Supabase → Project Settings → API. The service role key bypasses RLS: keep it secret.
# Without these, the site still shows the bundled catalog, but suggestions and the admin are disabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password for /opportunities/admin (use a long random value; changing it signs everyone out)
ADMIN_PASSWORD=
